{
  "version": "1.0",
  "ai": {
    "provider": "openai",
    "model": "openai-main/gpt-5.4-mini",
    "base_url": "${TFY_BASE_URL}",
    "api_key_env": "TFY_API_KEY",
    "analysis_concurrency": 5,
    "enrichment_concurrency": 5
  },
  "sources": {
    "github": [
      {
        "type": "user_events",
        "username": "torvalds",
        "enabled": false
      },
      {
        "type": "repo_releases",
        "owner": "astral-sh",
        "repo": "uv",
        "enabled": false
      }
    ],
    "hackernews": {
      "enabled": false,
      "fetch_top_stories": 20,
      "min_score": 100
    },
    "rss": [
      {
        "name": "WIRED AI",
        "url": "https://www.wired.com/feed/tag/ai/latest/rss",
        "enabled": true,
        "category": "ai-news"
      },
      {
        "name": "Cursor News",
        "url": "https://any-feeds.com/api/feeds/custom/cmkoaiogm0000lf04qmtirq2g/rss.xml",
        "enabled": true,
        "category": "ai-news"
      },
      {
        "name": "Claude News",
        "url": "https://any-feeds.com/api/feeds/custom/cmlwl4qxj0000l104m7a093k8/rss.xml",
        "enabled": true,
        "category": "ai-news"
      },
      {
        "name": "OpenAI News",
        "url": "https://openai.com/news/rss.xml",
        "enabled": true,
        "category": "ai-news"
      },
      {
        "name": "Google AI Blog",
        "url": "http://feeds.feedburner.com/blogspot/gJZg",
        "enabled": true,
        "category": "ai-research"
      },
      {
        "name": "Microsoft Research",
        "url": "https://www.microsoft.com/en-us/research/feed",
        "enabled": true,
        "category": "ai-research"
      },
      {
        "name": "NVIDIA AI Blog",
        "url": "http://feeds.feedburner.com/nvidiablog",
        "enabled": true,
        "category": "ai-research"
      },
      {
        "name": "BAIR (Berkeley AI Research)",
        "url": "https://bair.berkeley.edu/blog/feed.xml",
        "enabled": true,
        "category": "ai-research"
      },
      {
        "name": "MIT AI News",
        "url": "http://news.mit.edu/rss/topic/artificial-intelligence2",
        "enabled": true,
        "category": "ai-news"
      },
      {
        "name": "AI for Newsroom",
        "url": "https://aifornewsroom.in/api/rss",
        "enabled": true,
        "category": "ai-news"
      },
      {
        "name": "AWS Machine Learning Blog",
        "url": "https://aws.amazon.com/blogs/machine-learning/feed",
        "enabled": true,
        "category": "ai-engineering"
      },
      {
        "name": "arXiv cs.LG (Machine Learning)",
        "url": "http://arxiv.org/rss/cs.LG",
        "enabled": false,
        "category": "ai-research"
      },
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-tools"
      }
    ],
    "reddit": {
      "enabled": false,
      "subreddits": [
        {
          "subreddit": "MachineLearning",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 50
        }
      ],
      "users": [
        {
          "username": "iamthatis",
          "enabled": true,
          "sort": "new",
          "fetch_limit": 10
        }
      ],
      "fetch_comments": 5
    }
  },
  "filtering": {
    "ai_score_threshold": 8.0,
    "time_window_hours": 720,
    "topics": [
      "AI",
      "machine learning",
      "large language models",
      "ai model releases",
      "open source ai tools"
    ]
  },
  "blog": {
    "max_posts": 4,
    "prompt_profile": "practitioner"
  }
}